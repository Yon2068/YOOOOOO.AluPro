# component_selection_observer.rb
# 独立的组件选择观察者类
require "sketchup.rb"

require_relative "component_selection_observers/calc_alu_length"

module YOOOOOO
  module AluPro
    module Observers
      class ComponentSelectionObserver < Sketchup::SelectionObserver
        # 可选：添加回调支持
        attr_accessor :on_two_components_selected

        def initialize
          @on_two_components_selected = nil
          @last_components = []
          puts "[ComponentSelectionObserver] 已创建观察者实例。"
        end

        # 选择批量变化时触发
        def onSelectionBulkChange(selection)
          puts Utils::Dimensions.measure_component_height_enhanced(selection.first).mm
          # 获取所有选中的组件实例（包括组）
          components = selection.select do |entity|
            entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
          end

          puts "[ComponentSelectionObserver] 选择批量变化触发。"
          check_selection(selection)
        end

        # 选择添加时触发
        def onSelectionAdded(selection, entity)
          check_selection(selection)
        end

        # 选择移除时触发
        def onSelectionRemoved(selection, entity)
          check_selection(selection)
        end

        # 选择清空时触发
        def onSelectionCleared(selection)
          check_selection(selection)
        end

        private

        def check_selection(selection)
          # 获取所有选中的组件实例（包括组）
          components = selection.select do |entity|
            entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
          end

          # 如果正好选中两个组件，并且与上次选中的不同
          if components.length == 2
            comp1, comp2 = components

            # 防止重复触发
            unless same_components?(@last_components, components)
              @last_components = components.dup

              # 如果有回调，执行回调
              if @on_two_components_selected.respond_to?(:call)
                @on_two_components_selected.call(comp1, comp2)
              else
                # 默认行为
                handle_two_components(comp1, comp2)
              end
            end
          else
            @last_components = []
          end
        end

        def same_components?(old, new)
          return false if old.length != new.length
          old.map(&:guid).sort == new.map(&:guid).sort
        end

        # 默认处理方法（可以被子类重写）
        def handle_two_components(comp1, comp2)
          puts "[ComponentSelectionObserver] 选中了两个组件:"
          puts "  组件1: #{comp1.definition.name}" if comp1.respond_to?(:definition)
          puts "  组件2: #{comp2.definition.name}" if comp2.respond_to?(:definition)
          Observers::check_parallel_profiles
        end
      end

      # 扩展功能：带过滤的观察者
      class FilteredComponentObserver < ComponentSelectionObserver
        def initialize(component_filter = nil)
          super()
          @component_filter = component_filter # 可以是正则表达式、名称数组等
        end

        private

        def check_selection(selection)
          # 先调用父类方法获取组件
          components = selection.select do |entity|
            entity.is_a?(Sketchup::ComponentInstance) || entity.is_a?(Sketchup::Group)
          end

          # 应用过滤器
          if @component_filter
            components = components.select do |comp|
              name = comp.definition.name
              case @component_filter
              when Regexp
                name =~ @component_filter
              when Array
                @component_filter.include?(name)
              when Proc
                @component_filter.call(comp)
              else
                true
              end
            end
          end

          # 检查过滤后的组件数量
          if components.length == 2 && !same_components?(@last_components, components)
            @last_components = components.dup
            comp1, comp2 = components

            if @on_two_components_selected.respond_to?(:call)
              @on_two_components_selected.call(comp1, comp2)
            else
              handle_two_components(comp1, comp2)
            end
          elsif components.length != 2
            @last_components = []
          end
        end
      end
    end
  end
end
