# src/yoooo_aluminum/ui/callbacks.rb
module YOOOOOO
  module AluPro
    module UI
      module Callbacks
        extend self
        # 注册所有回调到对话框
        def register_all(dialog)
          register_snap_to_face_tool(dialog)
          register_quick_create_profile(dialog)
          register_create_profile(dialog)
          register_align_profiles(dialog)
          register_rotate_tool(dialog)
          register_move_profiles(dialog)
          register_rotate_profiles(dialog)
          register_flip_profiles(dialog)
          register_stretch_profiles(dialog)
          register_create_holes(dialog)
          register_add_corners(dialog)

          puts "已注册 #{callback_count} 个回调函数"
        end

        private

        # 统计已注册的回调数量
        def callback_count
          @callback_count ||= 0
        end

        # 吸附到面工具的回调
        def register_snap_to_face_tool(dialog)
          dialog.add_action_callback("snap_to_face_tool") do |_dialog, params|
            is_copy = params == "true"
            puts "收到 snap_to_face_tool 回调"
            # 调用核心功能模块

            Core.snap_to_face_tool(is_copy)
          end
          @callback_count = callback_count + 1
        end

        # 0. 创建铝型材(快速)的回调
        def register_quick_create_profile(dialog)
          dialog.add_action_callback("quick_create_profile") do |_dialog, params|

            # 解析参数：规格|长度|单位
            size = params
            puts "收到 quick_create_profile 回调，参数: #{size}"
            # 调用核心功能模块

            Core.quick_create_profile_tool(size)
          end
          @callback_count = callback_count + 1
        end

        # 1. 创建铝型材的回调
        def register_create_profile(dialog)
          dialog.add_action_callback("create_profile") do |_dialog, params|

            # 解析参数：规格|长度|单位
            size, length, unit = params.split("|")
            puts "收到 create_profile 回调，参数: #{size}, #{length}, #{unit}"
            # 调用核心功能模块
            # result = Core::ProfileCreator.create(size, length.to_f, unit)
            # result = Core::ImpAlu.ProfilePlacementTool #(size, length.to_f, unit)
            Core.create_profile_tool(size, length.to_f, unit)
            # 日志记录
            # log_callback("create_profile", "创建铝型材: #{size}, 长度: #{length}#{unit}")

            # 返回结果给前端
            # result ? "success" : "error: 创建失败"
          end
          @callback_count = callback_count + 1
        end

        # 2. 对齐铝型材的回调
        def register_align_profiles(dialog)
          dialog.add_action_callback("align_profiles") do |_dialog, params|
            align_type, reference = params.split("|")

            # 调用核心功能模块
            result = Core::AlignTool.align(align_type, reference)

            log_callback("align_profiles", "对齐操作: #{align_type}, 参考: #{reference}")

            result ? "success" : "error: 对齐失败"
          end
          @callback_count = callback_count + 1
        end

        # 2. 旋转铝型材的回调
        def rotate_tool(dialog)
          dialog.add_action_callback("rota") do |_dialog, params|
            align_type, reference = params.split("|")

            # 调用核心功能模块
            result = Core::AlignTool.align(align_type, reference)

            log_callback("align_profiles", "对齐操作: #{align_type}, 参考: #{reference}")

            result ? "success" : "error: 对齐失败"
          end
          @callback_count = callback_count + 1
        end

        # 3. 移动铝型材的回调
        def register_move_profiles(dialog)
          dialog.add_action_callback("move_profiles") do |_dialog, params|
            x, y, z, unit = params.split("|")

            # 调用核心功能模块
            result = Core::MoveTool.move(x.to_f, y.to_f, z.to_f, unit)

            log_callback("move_profiles", "移动: X=#{x}, Y=#{y}, Z=#{z}#{unit}")

            result ? "success" : "error: 移动失败"
          end
          @callback_count = callback_count + 1
        end

        # 4. 旋转铝型材的回调 (需要实现)
        def register_rotate_profiles(dialog)
          dialog.add_action_callback("rotate_profiles") do |_dialog, params|
            # 参数格式：角度|方向|轴
            angle, direction, axis = params.split("|")

            log_callback("rotate_profiles", "旋转: #{angle}度, #{direction}, 轴: #{axis}")

            # 这里调用旋转功能（需要先实现 Core::RotateTool）
            # result = Core::RotateTool.rotate(angle.to_f, direction, axis)

            "success"
          end
          @callback_count = callback_count + 1
        end

        # 5. 翻转铝型材的回调 (需要实现)
        def register_flip_profiles(dialog)
          dialog.add_action_callback("flip_profiles") do |_dialog, params|
            axis, copy = params.split("|")

            log_callback("flip_profiles", "翻转: 轴=#{axis}, 创建副本=#{copy}")

            # 这里调用翻转功能
            # result = Core::FlipTool.flip(axis, copy == "true")

            "success"
          end
          @callback_count = callback_count + 1
        end

        # 6. 拉伸铝型材的回调 (需要实现)
        def register_stretch_profiles(dialog)
          dialog.add_action_callback("stretch_profiles") do |_dialog, params|
            length, direction, keep_connections = params.split("|")

            log_callback("stretch_profiles", "拉伸: 长度=#{length}, 方向=#{direction}")

            # 这里调用拉伸功能
            # result = Core::StretchTool.stretch(length.to_f, direction, keep_connections == "true")

            "success"
          end
          @callback_count = callback_count + 1
        end

        # 7. 快速开孔的回调 (需要实现)
        def register_create_holes(dialog)
          dialog.add_action_callback("create_holes") do |_dialog, params|
            diameter, depth, hole_type = params.split("|")

            log_callback("create_holes", "开孔: 直径=#{diameter}mm, 深度=#{depth}mm, 类型=#{hole_type}")

            # 这里调用开孔功能
            # result = Core::HoleMaker.create(diameter.to_f, depth.to_f, hole_type)

            "success"
          end
          @callback_count = callback_count + 1
        end

        # 8. 添加角码的回调 (需要实现)
        def register_add_corners(dialog)
          dialog.add_action_callback("add_corners") do |_dialog, params|
            size, thickness, corner_type = params.split("|")

            log_callback("add_corners", "角码: 系列=#{size}, 厚度=#{thickness}mm, 类型=#{corner_type}")

            # 这里调用角码功能
            # result = Core::CornerAdder.add(size, thickness.to_f, corner_type)

            "success"
          end
          @callback_count = callback_count + 1
        end

        # 日志辅助方法
        def log_callback(callback_name, message)
          timestamp = Time.now.strftime("%H:%M:%S")
          puts "[#{timestamp}] 回调 #{callback_name}: #{message}"
        end

        # 获取所有已注册的回调名称列表（用于调试）
        def registered_callbacks
          [
            "create_profile",
            "align_profiles",
            "move_profiles",
            "rotate_profiles",
            "flip_profiles",
            "stretch_profiles",
            "create_holes",
            "add_corners",
          ]
        end
      end
    end
  end
end
